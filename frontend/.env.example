# therapy-aid frontend — copy to .env.local (gitignored). Every var is optional.
# Never put secrets in VITE_ vars: they are baked into the public JS bundle.

# Backend base URL. Leave unset: the SPA calls the relative /api, which nginx (Pi) and the Vite
# dev proxy both forward to the backend. An absolute URL puts the app back on two origins.
VITE_API_BASE_URL=

# Recording needs a secure context for the microphone: https (the tailnet URL) or localhost.
# Testing from a phone against `bun run dev` over plain http://<lan-ip>:5173 will NOT get the mic.

# development | production — a label only.
VITE_APP_ENV=development
