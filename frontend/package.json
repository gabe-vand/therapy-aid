        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react-swc": "^3.7.2",
        "happy-dom": "^20.8.9",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.1.16",
        "typescript": "^5.9.3",
        "vite": "^6.3.5",
