{
    "name": "therapy-aid",
    "private": true,
    "version": "0.0.1",
    "workspaces": [
        "backend",
        "frontend",
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run --cwd frontend dev",
        "dev:api": "bun run --cwd backend dev",
        "build": "bun run --cwd frontend build",
        "test": "bun run --cwd backend test && bun run --cwd frontend test",
        "deploy": "bash scripts/deploy.sh",
        "eval": "bun --env-file=backend/.env scripts/eval-models.ts"
    }
}
