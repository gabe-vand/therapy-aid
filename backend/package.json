{
    "name": "therapy-aid-backend",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "bun src/index.ts",
        "lint": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "test": "bun test ./tests",
        "test:watch": "bun test --watch ./tests"
    },
    "dependencies": {
        "@therapy-aid/shared": "workspace:*",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.12.16"
    },
    "devDependencies": {
        "@types/bun": "^1.3.13",
        "prettier": "^3.8.3",
        "typescript": "^5.9.3"
    }
}
