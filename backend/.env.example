# therapy-aid backend — copy to .env (gitignored) and run `bun --env-file=.env --watch src/index.ts`,
# or just `bun run dev`: every var below has a working local default.

# On the Pi none of this file is used. The Docker stack reads ~/therapy-aid.env instead
# (ANTHROPIC_API_KEY, DEEPGRAM_API_KEY, ALLOWED_TAILSCALE_LOGIN, APP_TIMEZONE, CLAUDE_MODEL_<TASK>,
# CLAUDE_EFFORT_<TASK>); docker-compose.yml passes them through. See .claude/skills/ship/SKILL.md.

# ── App ─────────────────────────────────────────────────────────────
# development | production. development listens on 127.0.0.1 only (dev auth lets everyone in);
# production (the container) listens on all interfaces.
APP_ENV=development
# HTTP port the Hono API listens on.
PORT=3010
# Git short SHA of the running build. Set by scripts/deploy.sh on the Pi; "dev" locally.
APP_REVISION=dev

# ── Database ────────────────────────────────────────────────────────
# SQLite file path. Created (with its folder) on first boot. On the Pi it is /data/… inside the
# `db-data` Docker volume, so it survives redeploys.
DB_PATH=./data/therapy-aid.sqlite

# ── Backups ─────────────────────────────────────────────────────────
# Daily verified snapshot of the database (therapy-aid-YYYY-MM-DD.sqlite). On the Pi this is
# /backups, bind-mounted from ~/therapy-aid-backups on the host.
BACKUP_DIR=./data/backups
# How many daily snapshots to keep; older ones are deleted.
BACKUP_RETENTION_DAYS=30

# ── Claude (AI) ─────────────────────────────────────────────────────
# Anthropic API key. Optional at boot — without it every AI feature fails with a clear
# "set ANTHROPIC_API_KEY" message. On the Pi it lives in ~/therapy-aid.env.
ANTHROPIC_API_KEY=
# Model routing is per task (src/services/common/svc-models.ts). Leave everything below empty to
# use the tested defaults. CLAUDE_MODEL forces ONE model for every task (e.g. claude-opus-5-5).
CLAUDE_MODEL=
# Per-task overrides win over CLAUDE_MODEL. Tasks: SUMMARIZE, MAP_PROBLEMS, FOCUS, INSIGHT, CHAT, TITLE.
# e.g. CLAUDE_MODEL_SUMMARIZE=claude-haiku-5-5
CLAUDE_MODEL_SUMMARIZE=
CLAUDE_MODEL_MAP_PROBLEMS=
CLAUDE_MODEL_FOCUS=
CLAUDE_MODEL_INSIGHT=
CLAUDE_MODEL_CHAT=
CLAUDE_MODEL_TITLE=
# Per-task effort: low | medium | high | xhigh | max. Empty = the task table's default.
CLAUDE_EFFORT_SUMMARIZE=
CLAUDE_EFFORT_MAP_PROBLEMS=
CLAUDE_EFFORT_FOCUS=
CLAUDE_EFFORT_INSIGHT=
CLAUDE_EFFORT_CHAT=
CLAUDE_EFFORT_TITLE=

# ── Deepgram (transcription) ────────────────────────────────────────
# Optional. Without it a recording fails at "transcribing" with a clear message; the audio stays
# on disk, so Retry works once the key is set. Pasted notes never need it.
DEEPGRAM_API_KEY=

# ── Auth ────────────────────────────────────────────────────────────
# The one Tailscale login allowed in (tailscale serve sends it as Tailscale-User-Login).
# Empty: every request is allowed as dev@local when APP_ENV=development, REJECTED otherwise
# (so on the Pi, forgetting it locks the app instead of opening it). Your tailnet login looks
# like you@gmail.com (admin console > Machines > the "Owner" column, or `tailscale whois <ip>`).
ALLOWED_TAILSCALE_LOGIN=

# ── Recordings ──────────────────────────────────────────────────────
# Session audio, one folder per session. On the Pi: /data/recordings (same volume as the db;
# set by backend/Dockerfile). NOT in the daily snapshots, which cover the database only.
RECORDINGS_DIR=./data/recordings

# ── Locale ──────────────────────────────────────────────────────────
# IANA time zone the AI context renders session/journal dates in, so "Sep 11" means your Sep 11
# and not UTC's. Unset falls back to America/New_York; a name that is not a real zone (a typo like
# America/NewYork) stops the API at boot rather than failing every AI call later.
APP_TIMEZONE=America/New_York
